# ── LLM providers (multi-provider fallback: Cerebras → Groq → Gemini) ──
# At least one is required. Cerebras recommended as primary (1M tokens/day free).
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai  (free, no card)
GROQ_API_KEY=            # https://console.groq.com   (free)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free, optional)

# ── Optional: market intelligence enrichment ──
APIFY_API_KEY=           # https://apify.com (optional — falls back to Groq market analysis)

# ── Infrastructure (defaults are fine for local dev) ──
DATABASE_URL=sqlite+aiosqlite:///./dealigent.db
CHROMA_PERSIST_DIR=./chroma_db
CORS_ORIGINS=http://localhost:5173
